# Copy this file to .env and fill in your own values. Never commit .env.

# Debug mode. Use True on your own computer ONLY. Leave it out on a public server.
DJANGO_DEBUG=True

# Required on a public server. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Comma-separated lists (set these on a public server)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# Free Gemini API key from Google AI Studio (never enable billing)
GEMINI_API_KEY=paste-your-key-here
# Models are tried in this order if one is busy
GEMINI_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.5-flash-lite

# Fair-use limits for the AI features (optional)
AI_DAILY_LIMIT_PER_USER=20
AI_GLOBAL_DAILY_LIMIT=200
AI_COOLDOWN_SECONDS=5

# Public server only: the PostgreSQL address from Neon. Leave empty to use SQLite.
DATABASE_URL=